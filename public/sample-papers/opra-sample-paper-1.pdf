// ──────────────────────────────────────────────────────
const LETTERS = ["A","B","C","D"];
let userAnswers = {}; // n -> letter
let revealed = new Set();

function render(list) {
  const c = document.getElementById("questionsContainer");
  c.innerHTML = "";
  document.getElementById("noResults").style.display = list.length ? "none" : "block";
  list.forEach((q, idx) => {
    const card = document.createElement("div");
    card.className = "q-card" + (userAnswers[q.n] ? " answered" : "");
    card.id = "card-" + q.n;
    card.style.animationDelay = (idx * 0.02) + "s";

    const optHtml = q.opts.map((o, i) => {
      const l = LETTERS[i];
      const ua = userAnswers[q.n];
      const isRev = revealed.has(q.n);
      let cls = "opt";
      if (ua === l) cls += " selected";
      if ((ua || isRev) && l === q.ans) cls += " correct";
      if (ua && ua !== q.ans && ua === l) cls += " wrong";
      return `<div class="${cls}" onclick="pick(${q.n},'${l}')">
        <span class="opt-letter">${l}</span>
        <span class="opt-text">${o}</span>
      </div>`;
    }).join("");

    const ua = userAnswers[q.n];
    const isRev = revealed.has(q.n);
    let fbHtml = "";
    if (ua || isRev) {
      if (ua === q.ans) {
        fbHtml = `<div class="feedback correct-fb show">✅ Correct! Answer: <strong>${q.ans}</strong></div>`;
      } else if (ua) {
        fbHtml = `<div class="feedback wrong-fb show">❌ Incorrect. Correct answer: <strong>${q.ans}</strong></div>`;
      } else {
        fbHtml = `<div class="feedback correct-fb show">👁 Answer: <strong>${q.ans}</strong></div>`;
      }
    }

    card.innerHTML = `
      <div class="q-header" onclick="toggleCard(${q.n})">
        <span class="q-num">Q${q.n}</span>
        <span class="q-text">${q.q}</span>
        <span class="q-toggle">▾</span>
      </div>
      <div class="q-options">${optHtml}</div>
      ${fbHtml}
    `;
    c.appendChild(card);
  });
  updateStats();
  updateProgress();
}

function toggleCard(n) {
  const card = document.getElementById("card-" + n);
  card.classList.toggle("open");
}

function pick(n, letter) {
  if (userAnswers[n]) return; // locked
  userAnswers[n] = letter;
  filterQuestions(); // re-render current view
}

function filterQuestions() {
  const q = document.getElementById("searchBox").value.toLowerCase().trim();
  const list = q ? questions.filter(x => x.q.toLowerCase().includes(q) || x.opts.some(o => o.toLowerCase().includes(q)) || String(x.n).includes(q)) : questions;
  render(list);
}

function updateStats() {
  const answered = Object.keys(userAnswers).length;
  const correct  = Object.keys(userAnswers).filter(n => userAnswers[n] === questions[n-1].ans).length;
  document.getElementById("statAnswered").textContent = answered;
  document.getElementById("statCorrect").textContent  = correct;
  document.getElementById("statWrong").textContent    = answered - correct;
}

function updateProgress() {
  const pct = (Object.keys(userAnswers).length / 120) * 100;
  document.getElementById("progressBar").style.width = pct + "%";
}

function showScore() {
  const answered = Object.keys(userAnswers).length;
  const correct  = Object.keys(userAnswers).filter(n => userAnswers[n] === questions[n-1].ans).length;
  const pct = answered ? Math.round((correct / answered) * 100) : 0;
  const total120 = Math.round((correct / 120) * 100);
  document.getElementById("scorePct").textContent = pct + "%";
  document.getElementById("scoreDetail").innerHTML =
    `Answered: <strong>${answered}</strong> / 120<br>` +
    `Correct: <strong>${correct}</strong><br>` +
    `Incorrect: <strong>${answered - correct}</strong><br>` +
    `Score (of 120): <strong>${total120}%</strong>`;
  const panel = document.getElementById("scorePanel");
  panel.classList.add("visible");
  panel.scrollIntoView({ behavior: "smooth" });
}

function resetAll() {
  userAnswers = {};
  revealed.clear();
  document.getElementById("searchBox").value = "";
  document.getElementById("scorePanel").classList.remove("visible");
  filterQuestions();
}

function revealAllAnswers() {
  questions.forEach(q => revealed.add(q.n));
  filterQuestions();
}

function expandAll() {
  document.querySelectorAll(".q-card").forEach(c => c.classList.add("open"));
}

// Initial render
filterQuestions();
</script>
</body>
</html>
