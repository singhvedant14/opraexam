<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>OPRA® Exam Sample — Australian Pharmacy Council</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
  :root {
    --apc-green: #2da06e;
    --apc-teal: #1a8c5c;
    --apc-dark: #0d3b28;
    --apc-mid: #1f6b4a;
    --bg: #f5f7f5;
    --surface: #ffffff;
    --border: #e0ebe5;
    --text: #1a2e22;
    --muted: #5a7a68;
    --correct: #22c55e;
    --opt-hover: #edfaf3;
    --opt-selected: #d1fae5;
    --opt-selected-border: #2da06e;
    --radius: 12px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    font-size: 15px;
    line-height: 1.6;
  }

  /* ── HEADER ── */
  .site-header {
    background: linear-gradient(135deg, var(--apc-dark) 0%, var(--apc-mid) 60%, var(--apc-green) 100%);
    color: white;
    padding: 0;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 20px rgba(13,59,40,0.35);
  }
  .header-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .logo-pill {
    background: white;
    border-radius: 10px;
    padding: 6px 12px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .logo-pill span { font-family: 'DM Mono', monospace; font-size: 13px; color: var(--apc-dark); font-weight: 500; }
  .header-text h1 { font-family: 'Playfair Display', serif; font-size: 1.3rem; letter-spacing: .01em; }
  .header-text p  { font-size: 0.78rem; opacity: 0.8; margin-top: 2px; }
  .header-badges { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; }
  .badge {
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 20px;
    padding: 3px 10px;
    font-size: 0.72rem;
    white-space: nowrap;
    font-weight: 500;
  }

  /* ── PROGRESS BAR ── */
  .progress-bar-wrap {
    background: rgba(0,0,0,0.2);
    height: 4px;
  }
  #progressBar { height: 4px; background: #6ee7b7; width: 0; transition: width .3s ease; }

  /* ── CONTROLS ── */
  .controls {
    max-width: 960px;
    margin: 20px auto 0;
    padding: 0 20px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }
  .controls input {
    flex: 1; min-width: 200px;
    padding: 9px 14px;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    background: white;
    outline: none;
    transition: border-color .2s;
  }
  .controls input:focus { border-color: var(--apc-green); }
  .btn {
    padding: 9px 18px;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all .15s;
  }
  .btn-primary { background: var(--apc-green); color: white; }
  .btn-primary:hover { background: var(--apc-teal); transform: translateY(-1px); }
  .btn-outline { background: white; color: var(--apc-mid); border: 1.5px solid var(--border); }
  .btn-outline:hover { border-color: var(--apc-green); background: var(--opt-hover); }

  .stats-row {
    max-width: 960px;
    margin: 12px auto 0;
    padding: 0 20px;
    display: flex;
    gap: 18px;
    font-size: 13px;
    color: var(--muted);
  }
  .stats-row strong { color: var(--apc-dark); }

  /* ── QUESTION CARDS ── */
  #questionsContainer {
    max-width: 960px;
    margin: 20px auto 40px;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .q-card {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow .2s, border-color .2s;
    animation: fadeUp .3s ease both;
  }
  .q-card:hover { box-shadow: 0 4px 16px rgba(45,160,110,.1); border-color: #c5dfd2; }
  .q-card.answered { border-color: var(--opt-selected-border); }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .q-header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 20px 14px;
    cursor: pointer;
    user-select: none;
  }
  .q-num {
    background: var(--apc-dark);
    color: white;
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    border-radius: 6px;
    padding: 3px 8px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .q-card.answered .q-num { background: var(--apc-green); }

  .q-text {
    font-size: 14.5px;
    font-weight: 500;
    flex: 1;
    line-height: 1.55;
  }
  .q-text em { font-style: italic; }
  .q-text strong { font-weight: 700; }

  .q-toggle {
    color: var(--muted);
    font-size: 18px;
    flex-shrink: 0;
    transition: transform .2s;
  }
  .q-card.open .q-toggle { transform: rotate(180deg); }

  /* sub-stem (second paragraph in some questions) */
  .q-stem {
    padding: 0 20px 10px 52px;
    font-size: 13.5px;
    color: var(--muted);
    font-style: italic;
    display: none;
  }
  .q-card.open .q-stem { display: block; }

  /* table inside question */
  .q-table-wrap {
    padding: 0 20px 12px 52px;
    display: none;
  }
  .q-card.open .q-table-wrap { display: block; }
  .q-table {
    border-collapse: collapse;
    font-size: 13px;
    width: 100%;
    max-width: 420px;
  }
  .q-table th, .q-table td {
    border: 1px solid var(--border);
    padding: 6px 12px;
    text-align: left;
  }
  .q-table th { background: #f0f7f3; font-weight: 600; }

  .q-options {
    padding: 0 20px 18px 52px;
    display: none;
    flex-direction: column;
    gap: 8px;
  }
  .q-card.open .q-options { display: flex; }

  .opt {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1.5px solid var(--border);
    cursor: pointer;
    transition: all .15s;
    font-size: 13.5px;
    line-height: 1.5;
    background: white;
  }
  .opt:hover { background: var(--opt-hover); border-color: var(--apc-green); }
  .opt.selected { background: var(--opt-selected); border-color: var(--opt-selected-border); }
  .opt.correct { background: #dcfce7; border-color: #22c55e; }
  .opt.wrong   { background: #fee2e2; border-color: #ef4444; }

  .opt-letter {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    background: var(--bg);
    border-radius: 4px;
    padding: 2px 7px;
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--apc-dark);
  }
  .opt.selected .opt-letter,
  .opt.correct  .opt-letter { background: var(--apc-green); color: white; }
  .opt.wrong    .opt-letter { background: #ef4444; color: white; }

  .opt-text { flex: 1; }
  .opt-text em { font-style: italic; }

  .feedback {
    display: none;
    margin: 2px 20px 14px 52px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
  }
  .feedback.show { display: flex; align-items: center; gap: 8px; }
  .feedback.correct-fb { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
  .feedback.wrong-fb   { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

  /* ── SCORE PANEL ── */
  .score-panel {
    display: none;
    max-width: 960px;
    margin: 0 auto 30px;
    padding: 0 20px;
  }
  .score-panel.visible { display: block; }
  .score-inner {
    background: linear-gradient(135deg, var(--apc-dark), var(--apc-mid));
    color: white;
    border-radius: var(--radius);
    padding: 28px 32px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .score-big { font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 700; }
  .score-label { font-size: 0.85rem; opacity: 0.8; margin-top: 2px; }
  .score-detail { font-size: 14px; opacity: 0.9; line-height: 1.8; }
  .score-detail strong { color: #6ee7b7; }

  /* ── DISCLAIMER ── */
  .disclaimer {
    max-width: 960px;
    margin: 0 auto 20px;
    padding: 0 20px;
  }
  .disclaimer-inner {
    background: #fffbeb;
    border: 1px solid #fcd34d;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 12px;
    color: #92400e;
  }

  /* ── NO RESULTS ── */
  #noResults {
    display: none;
    text-align: center;
    padding: 60px 20px;
    color: var(--muted);
    font-size: 15px;
  }

  @media (max-width: 600px) {
    .header-badges { display: none; }
    .q-options { padding-left: 20px; }
    .q-stem, .q-table-wrap { padding-left: 20px; }
    .feedback { margin-left: 20px; }
    .score-big { font-size: 2.2rem; }
  }
</style>
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <div class="logo-pill">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#2da06e"/><path d="M8 12h8M12 8v8" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
      <span>APC</span>
    </div>
    <div class="header-text">
      <h1>OPRA® Exam Sample</h1>
      <p>Overseas Pharmacists Readiness Assessment · Sample 1 · Version 1.3 (2 May 2025)</p>
    </div>
    <div class="header-badges">
      <span class="badge">120 Questions</span>
      <span class="badge">150 min</span>
      <span class="badge">MCQ</span>
    </div>
  </div>
  <div class="progress-bar-wrap"><div id="progressBar"></div></div>
</header>

<div class="controls">
  <input type="text" id="searchBox" placeholder="🔍  Search questions…" oninput="filterQuestions()"/>
  <button class="btn btn-primary" onclick="showScore()">📊 Check Score</button>
  <button class="btn btn-outline" onclick="resetAll()">↺ Reset</button>
  <button class="btn btn-outline" onclick="revealAllAnswers()">👁 Show All Answers</button>
  <button class="btn btn-outline" onclick="expandAll()">⊞ Expand All</button>
</div>

<div class="stats-row">
  <span>Answered: <strong id="statAnswered">0</strong> / 120</span>
  <span>Correct: <strong id="statCorrect">0</strong></span>
  <span>Incorrect: <strong id="statWrong">0</strong></span>
</div>

<div class="disclaimer">
  <div class="disclaimer-inner">
    ⚠️ <strong>Note:</strong> This sample paper is for practice purposes only. These questions are no longer used in live OPRA® exams. While answers are reviewed frequently, the APC does not guarantee accuracy due to potential changes in pharmacy practice guidelines or legislation.
  </div>
</div>

<div class="score-panel" id="scorePanel">
  <div class="score-inner">
    <div>
      <div class="score-big" id="scorePct">—%</div>
      <div class="score-label">Overall Score</div>
    </div>
    <div class="score-detail" id="scoreDetail"></div>
  </div>
</div>

<div id="questionsContainer"></div>
<div id="noResults">No questions match your search.</div>

<script>
// ─────────────────────────────────────────────
// DATA: All 120 questions from the OPRA® Sample
// ─────────────────────────────────────────────
const questions = [
  { n:1,  q:"Gemfibrozil is used to treat which condition?", opts:["Hyperlipidaemia","Hyperglycaemia","Hyperaldosteronism","Hypertension"], ans:"A" },
  { n:2,  q:"What is the usual range of hydrochlorothiazide daily dose for an adult?", opts:["0.5 - 1 mg","2 - 5 mg","6.25 - 25 mg","50 - 100 mg"], ans:"C" },
  { n:3,  q:"A 30 kg child is to be administered 250 mg of metronidazole every 8 hours. Each mL of a 500 mg/500 mL ampoule of metronidazole contains 0.135 millimol/mL of sodium. What is the amount of sodium the child will receive in 24 hours?", opts:["33.8 millimol","101.3 millimol","202.5 millimol","1852 millimol"], ans:"B" },
  { n:4,  q:"What amount of chlorinated lime (available chlorine = 30% w/w) is required to obtain a chlorine concentration of 1.5 ppm in an animal drenching facility of 6000 L?", opts:["3 g","27 g","30 g","270 g"], ans:"C" },
  { n:5,  q:"Where are alpha-1 adrenoreceptors primarily located?", opts:["Arterioles","Bronchioles","Atria","Cardiac ventricles"], ans:"A" },
  { n:6,  q:"Sodium polystyrene sulfonate exerts its therapeutic effect by acting as an exchange resin. Which ONE of the following ions is exchanged with sodium?", opts:["Potassium","Phosphorus","Calcium","Chloride"], ans:"A" },
  { n:7,  q:"What is the daily recommended calcium intake for post-menopausal women?", opts:["300 - 600 mg","700 - 900 mg","1000 - 1500 mg","1600 - 2000 mg"], ans:"C" },
  { n:8,  q:"Which ONE of the following drugs is generally avoided in children under 12 years of age?", opts:["Norfloxacin","Amoxicillin","Azithromycin","Rifampicin"], ans:"A" },
  { n:9,  q:"Which ONE of the following is <strong>NOT</strong> an official pharmacopeial testing procedure for tablets?", opts:["Dissolution","Hardness","Disintegration","Friability"], ans:"B" },
  { n:10, q:"Which ONE of the following parameters does <strong>NOT</strong> influence the steady state plasma concentration of a drug administered intravenously?", opts:["Dose","Drug clearance","Volume of distribution","Dosing interval"], ans:"C" },
  { n:11, q:"Wool fat is not available and needs to be replaced by lanolin (contains water 28% w/w and wool fat 72% w/w). Prescription: Zinc oxide 2 g, Calamine 2 g, Wool fat 36 g, Water to 60 g. How many grams of lanolin and water should be used?", opts:["34 g lanolin, 22 mL water","40 g lanolin, 16 mL water","46 g lanolin, 10 mL water","50 g lanolin, 6 mL water"], ans:"D" },
  { n:12, q:"Which ONE of the following is a major determinant of myocardial oxygen demand?", opts:["Systolic blood pressure","Diastolic blood pressure","Cardiac output","Blood volume"], ans:"C" },
  { n:13, q:"What is the mode of action of allopurinol?", opts:["To increase renal excretion of uric acid","To inhibit formation of uric acid","To inhibit absorption of dietary purines","To inhibit prostaglandin synthesis"], ans:"B" },
  { n:14, q:"Which ONE of the following can be used to separate an enantiomer from its racemate?", opts:["Acid-base reaction","Boiling point","Chromatography","Infrared spectrometry"], ans:"C" },
  { n:15, q:"After initial immunisation with tetanus toxoid, how often should booster injections be given?", opts:["Every 2 years","Every 3 years","Every 5 years","Every 10 years"], ans:"D" },
  { n:16, q:"Which drug is the <strong>MOST</strong> useful for the management of metastatic bone pain?", opts:["Meloxicam","Fentanyl","Amitriptyline","Carbamazepine"], ans:"A" },
  { n:17, q:"Data from 2 batches: Batch 1 = 100 mg / 55% bioavailability; Batch 2 = 200 mg / 165% bioavailability. What is the absolute bioavailability of Batch 2?", opts:["33.33%","61.6%","90.75%","300%"], ans:"C" },
  { n:18, q:"Which penicillin is effective in the presence of penicillinase?", opts:["Amoxicillin","Flucloxacillin","Phenoxymethylpenicillin","Ticarcillin"], ans:"B" },
  { n:19, q:"Which of the following causes muscle fatigue?", opts:["Ischaemia due to atherosclerotic plaques","Accumulation of lactic acid","Lack of sufficient ATP molecules","Accumulation of carbon dioxide"], ans:"B" },
  { n:20, q:"Ferrous Sulphate Mixture contains 300 mg of Ferrous Sulphate/10 mL. A person takes 10 mL three times a day. [FeSO₄·7H₂O MW=278, Fe MW=55.9] What is the total daily amount of iron?", opts:["3.23 mg","17.1 mg","60.0 mg","181.0 mg"], ans:"D" },
  { n:21, q:"What is the pain associated with angina pectoris caused by?", opts:["Spasm of the aorta","Ventricular tachycardia","Aortic stenosis","Myocardial ischaemia"], ans:"D" },
  { n:22, q:"Uncomplicated urinary tract infections (UTIs) are <strong>MOST</strong> commonly caused by which organism?", opts:["Staphylococcus saprophyticus","Campylobacter jejuni","Giardia lamblia","Moraxella catarrhalis"], ans:"A" },
  { n:23, q:"Bipolar disorder <strong>CANNOT</strong> be treated using which medication?", opts:["Lithium","Haloperidol","Sodium valproate","Paroxetine"], ans:"D" },
  { n:24, q:"Why are methylcellulose and similar agents used for ophthalmic solutions?", opts:["To increase ocular exposure time","To reduce inflammation of the eye by their soothing effect","To suspend soluble drugs","To reduce drop size"], ans:"A" },
  { n:25, q:"Which ONE of the following should be avoided in a patient taking moclobemide?", opts:["Ranitidine","Nitrazepam","Sumatriptan","Furosemide"], ans:"C" },
  { n:26, q:"Which ONE of the following is <strong>NOT</strong> a central neurotransmitter?", opts:["Serotonin","Noradrenaline","Dopamine","Cyclic adenosine phosphate"], ans:"D" },
  { n:27, q:"Which ONE of the following is <strong>NOT</strong> used for treatment of epilepsy?", opts:["Clonazepam","Oxazepam","Diazepam","Lorazepam"], ans:"B" },
  { n:28, q:"Tinnitus, headaches, nausea and sweating are symptoms of which ONE of the following adverse effects?", opts:["Aspirin hypersensitivity","Paracetamol toxicity","Salicylate toxicity","Paracetamol hypersensitivity"], ans:"C" },
  { n:29, q:"What is the primary pharmacological effect of isoprenaline?", opts:["Blocks alpha adrenoceptors","Stimulates beta adrenoceptors","Releases noradrenaline from noradrenergic nerves","Blocks dopaminergic receptors"], ans:"B" },
  { n:30, q:"Which measure is used to monitor the effectiveness of enoxaparin therapy?", opts:["Enoxaparin blood level","International Normalised Ratio (INR)","Platelet count","Antifactor Xa"], ans:"D" },
  { n:31, q:"A patient is prescribed Lugol's Solution (5% iodine) 0.3 mL three times a day. How much iodine does this provide each day?", opts:["15 mg","30 mg","45 mg","90 mg"], ans:"C" },
  { n:32, q:"What does oxidation of a secondary alcohol yield?", opts:["Ketone","Primary alcohol","Aldehyde","Ether"], ans:"A" },
  { n:33, q:"How much of ingredient A is required to make 500 mL of an aqueous solution, so that 25 mL diluted to 100 mL with water gives a 1:2000 solution?", opts:["0.1 g","1 g","1.25 g","2.5 g"], ans:"B" },
  { n:34, q:"Which ONE of the following is a recommended treatment option for pain due to herpes zoster?", opts:["Topical betamethasone dipropionate","Transcutaneous electrical nerve stimulation (TENS)","Topical capsaicin","Topical tretinoin"], ans:"C" },
  { n:35, q:"What is the effect of parathyroid hormone?", opts:["Increased mobilisation of calcium from bone","Decreased renal tubular reabsorption of calcium","Decreased resorption of phosphate from bone","Decreased excretion of phosphate"], ans:"A" },
  { n:36, q:"What is the <strong>MOST</strong> appropriate treatment for an infestation of scabies?", opts:["Permethrin","Mebendazole","Malathion","Tinidazole"], ans:"A" },
  { n:37, q:"A drug susceptible to hydrolysis (first order kinetics) has initial concentration 0.16 molar; after 6 days it decreased to 0.04 molar. What is the half-life?", opts:["1 day","2 days","3 days","4 days"], ans:"C" },
  { n:38, q:"The composition of sweat is altered in which disease state?", opts:["Hypothyroidism","Glomerulonephritis","Diabetes insipidus","Cystic fibrosis"], ans:"D" },
  { n:39, q:"Propranolol is <strong>NOT</strong> used in the management of which ONE of the following conditions?", opts:["Oesophageal varices","Phaeochromocytoma","Hypothyroidism","Migraine"], ans:"C" },
  { n:40, q:"Which structure(s) prevent backflow of blood into the ventricles of the heart?", opts:["Valves in the veins","Atrio-ventricular valves","Pericardium","Aortic and pulmonary valves"], ans:"D" },
  { n:41, q:"Prescription: Sucralfate 1 g × 8 tablets, Sorbitol 70% solution 40 mL, Water to 120 mL. What is the percentage (%) of sucralfate in the final suspension?", opts:["1.0%","6.7%","8.0%","13.4%"], ans:"B" },
  { n:42, q:"What type of laxative is docusate sodium?", opts:["Stimulant","Bulk-forming","Softener","Osmotic"], ans:"C" },
  { n:43, q:"If a patient uses salbutamol and beclometasone metered dose inhalers TWICE a day, when should the beclometasone be used?", opts:["5 minutes after salbutamol","Immediately after salbutamol","5 minutes before salbutamol","Immediately before salbutamol"], ans:"A" },
  { n:44, q:"Which ONE of the following gram-positive organisms and anaerobes is resistant to treatment by the broad spectrum antibiotic clindamycin?", opts:["Staphylococcus saprophyticus","Clostridium perfringens","Haemophilus influenzae","Actinomyces"], ans:"C" },
  { n:45, q:"Which of the following drugs has the longest half-life?", opts:["Amiodarone","Morphine","Verapamil","Amlodipine"], ans:"A" },
  { n:46, q:"An adult is injected with 100 mg of a drug; resultant plasma concentration is 2.5 microgram/mL. What is the subject's volume of body water?", opts:["0.4 L","4 L","40 L","400 L"], ans:"C" },
  { n:47, q:"Which ONE of the following is a potential common adverse effect with the use of fluoxetine?", opts:["Hepatitis","Nose bleeds","Insomnia","Taste disturbances"], ans:"C" },
  { n:48, q:"Which ONE of the following is <strong>NOT</strong> an adverse effect of tricyclic antidepressants?", opts:["Sedation","Diarrhoea","Blurred vision","Urinary retention"], ans:"B" },
  { n:49, q:"Which condition is characterised by destruction of myelin sheath surrounding nerve axons?", opts:["Huntington's chorea","Multiple sclerosis","Parkinson's disease","Tardive dyskinesia"], ans:"B" },
  { n:50, q:"Which of the following statements about beta-blockers for congestive heart failure is <strong>INCORRECT</strong>?", opts:["May cause bradycardia","Prevent ventricular remodelling","Can increase injection fraction","Increase AV nodal conduction"], ans:"D" },
  { n:51, q:"A laxative is <strong>MOST</strong> likely to be used to manage a common adverse effect of which medication?", opts:["Piroxicam","Oxycodone","Cefalexin","Dexamethasone"], ans:"B" },
  { n:52, q:"A physician orders 2 g medication added to 500 mL IV fluid at 125 mL/hour. How much cefalotin will the patient receive per minute?", opts:["8.33 mg","83.3 mg","500 mg","833 mg"], ans:"A" },
  { n:53, q:"Produce 1 L NaCl solution so that 20 mL diluted to 100 mL gives 0.9% w/v. Using 2.25 g tablets, how many tablets are required?", opts:["4.5","9","20","45"], ans:"C" },
  { n:54, q:"What is the main effect of vasopressin?", opts:["To increase blood pressure, increasing formation of nephric filtrate","To cause active transport of urea and uric acid from renal blood into tubules","To inhibit aldosterone action","To cause reabsorption of water"], ans:"D" },
  { n:55, q:"If 400 mg of potassium permanganate is dissolved in 2.5 L of water, what is the strength of the resulting solution?", opts:["0.016%","0.032%","0.064%","0.16%"], ans:"A" },
  { n:56, q:"Which ONE of the following should be regularly monitored in a patient taking amiodarone?", opts:["Prostate specific antigen","Urinary cortisol","Serum creatinine","Thyroid function tests"], ans:"D" },
